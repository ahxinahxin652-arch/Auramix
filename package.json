{
  "name": "auramix",
  "version": "1.0.20",
  "description": "Auramix - 沉浸式音乐流媒体播放器",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:exe": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@clamber_l/crypto": "^0.1.12",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "element-plus": "^2.14.0",
    "express": "^4.18.2",
    "ffmetadata": "^1.7.0",
    "howler": "^2.2.4",
    "multer": "^2.2.0",
    "music-metadata": "^11.12.3",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "prisma": "^5.22.0",
    "vite": "^8.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.auramix.app",
    "productName": "Auramix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "server/generated/prisma-client/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auramix"
    }
  }
}
