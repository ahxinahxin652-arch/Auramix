// Prisma Schema for FlacConverter (Auramix Online)
// Aligning with auramix_mysql_schema.sql (using BigInt for all IDs, matching fields and types)

generator client {
  provider = "prisma-client-js"
  output   = "../server/generated/prisma-client"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// 1. 用户表
model User {
  id           BigInt   @id @map("id")
  email        String   @unique @map("email")
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  country      String   @default("CN") @map("country")
  product      Int      @default(0) @map("product")
  status       Int      @default(0) @map("status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  playlists         Playlist[]         @relation("PlaylistOwner")
  playlistFollowers PlaylistFollower[]
  artistFollowers   ArtistFollower[]
  likedTracks       LikedTrack[]
  likedAlbums       LikedAlbum[]
  playbackHistories PlaybackHistory[]

  @@map("users")
}

// 2. 歌手/艺人表
model Artist {
  id        BigInt   @id @map("id")
  name      String   @unique @map("name")
  coverImg  String?  @map("cover_img")
  bio       String?  @map("bio")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tracks          TrackArtist[]
  albums          AlbumArtist[]
  artistFollowers ArtistFollower[]

  @@map("artists")
}

// 3. 专辑表
model Album {
  id          BigInt   @id @map("id")
  title       String   @map("title")
  coverUrl    String?  @map("cover_url")
  releaseDate DateTime @map("release_date")
  albumType   Int      @default(0) @map("album_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tracks       Track[]
  artists      AlbumArtist[]
  likedAlbums  LikedAlbum[]

  @@map("albums")
}

// 4. 单曲/曲目表
model Track {
  id          BigInt   @id @map("id")
  albumId     BigInt   @map("album_id")
  title       String   @map("title")
  duration    Int      @map("duration")
  lyricsUrl   String?  @map("lyrics_url")
  status      Int      @default(0) @map("status")
  likedCount  Int      @default(0) @map("liked_count")
  playCount   BigInt   @default(0) @map("play_count")
  trackNumber Int      @map("track_number")
  discNumber  Int      @default(1) @map("disc_number")
  member      Int      @default(0) @map("member")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  album          Album                @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artists        TrackArtist[]
  audioResources TrackAudioResource[]
  videoResources TrackVideoResource[]
  playlistTracks PlaylistTrack[]
  likedTracks    LikedTrack[]
  playbacks      PlaybackHistory[]
  genres         TrackGenre[]

  @@index([albumId])
  @@map("tracks")
}

// 5. 歌曲-歌手关联表
model TrackArtist {
  trackId  BigInt @map("track_id")
  artistId BigInt @map("artist_id")
  role     Int    @default(0) @map("role")

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([trackId])
  @@index([artistId])
  @@map("track_artists")
}

// 6. 专辑-歌手关联表
model AlbumArtist {
  albumId  BigInt @map("album_id")
  artistId BigInt @map("artist_id")

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([albumId])
  @@index([artistId])
  @@map("album_artists")
}

// 7. 音源资源表
model TrackAudioResource {
  id        BigInt   @id @map("id")
  trackId   BigInt   @map("track_id")
  quality   Int      @default(1) @map("quality")
  format    Int      @default(0) @map("format")
  bitrate   Int      @map("bitrate")
  streamUrl String   @map("stream_url")
  size      BigInt   @map("size")
  createdAt DateTime @default(now()) @map("created_at")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
  @@map("track_audio_resources")
}

// 8. MV 视频资源表
model TrackVideoResource {
  id         BigInt   @id @map("id")
  trackId    BigInt   @map("track_id")
  quality    Int      @default(1) @map("quality")
  resolution String   @map("resolution")
  fps        Int      @default(30) @map("fps")
  format     Int      @default(0) @map("format")
  bitrate    Int      @map("bitrate")
  streamUrl  String   @map("stream_url")
  size       BigInt   @map("size")
  createdAt  DateTime @default(now()) @map("created_at")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
  @@map("track_video_resources")
}

// 9. 流派表
model Genre {
  id        BigInt   @id @map("id")
  name      String   @unique @map("name")
  createdAt DateTime @default(now()) @map("created_at")

  tracks TrackGenre[]

  @@map("genres")
}

// 10. 歌曲-流派关联表
model TrackGenre {
  trackId BigInt @map("track_id")
  genreId BigInt @map("genre_id")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([trackId])
  @@index([genreId])
  @@map("track_genres")
}

// 11. 歌单表
model Playlist {
  id          BigInt   @id @map("id")
  ownerId     BigInt   @map("owner_id")
  name        String   @map("name")
  description String?  @map("description")
  coverUrl    String?  @map("cover_url")
  isPublic    Int      @default(1) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  owner     User               @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]
  followers PlaylistFollower[]

  @@index([ownerId])
  @@map("playlists")
}

// 12. 歌单-歌曲关联表
model PlaylistTrack {
  playlistId BigInt   @map("playlist_id")
  trackId    BigInt   @map("track_id")
  sortOrder  Int      @default(0) @map("sort_order")
  addedAt    DateTime @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
}

// 13. 歌单关注表
model PlaylistFollower {
  playlistId BigInt   @map("playlist_id")
  userId     BigInt   @map("user_id")
  followedAt DateTime @default(now()) @map("followed_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
  @@index([playlistId])
  @@index([userId])
  @@map("playlist_followers")
}

// 14. 歌手关注表
model ArtistFollower {
  artistId   BigInt   @map("artist_id")
  userId     BigInt   @map("user_id")
  followedAt DateTime @default(now()) @map("followed_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([artistId, userId])
  @@index([artistId])
  @@index([userId])
  @@map("artist_followers")
}

// 15. 单曲收藏表
model LikedTrack {
  userId  BigInt   @map("user_id")
  trackId BigInt   @map("track_id")
  likedAt DateTime @default(now()) @map("liked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId])
  @@index([trackId])
  @@map("liked_tracks")
}

// 16. 专辑收藏表
model LikedAlbum {
  albumId BigInt   @map("album_id")
  userId  BigInt   @map("user_id")
  likedAt DateTime @default(now()) @map("liked_at")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([albumId, userId])
  @@index([albumId])
  @@index([userId])
  @@map("liked_albums")
}

// 17. 播放历史记录表
model PlaybackHistory {
  id          BigInt   @id @map("id")
  userId      BigInt   @map("user_id")
  trackId     BigInt   @map("track_id")
  playedAt    DateTime @default(now()) @map("played_at")
  contextType Int?     @map("context_type")
  contextId   BigInt?  @map("context_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@map("playback_history")
}
